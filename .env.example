# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# SMTP EMAIL NOTIFICATION CONFIGURATION (Hostinger / Standard SMTP)
# Used for automatic notification emails on Contact Inquiries & Online Admissions
# ==============================================================================
# Official Destination Mailbox (defaults to futuregatesitcenter@gmail.com)
EMAIL_TO=futuregatesitcenter@gmail.com

# SMTP Server Settings (Hostinger default is smtp.hostinger.com on port 465)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true

# SMTP Mailbox Credentials
SMTP_USER=futuregatesitcenter@gmail.com
SMTP_PASSWORD=

# Sender Name & From Address
EMAIL_FROM="Future Gates IT Center" <futuregatesitcenter@gmail.com>

# ==============================================================================
# MASTER ADMINISTRATOR OVERRIDES (Optional)
# ==============================================================================
ADMIN_USERNAME=futuregatesitcenter@gmail.com
ADMIN_PASSWORD=

